@page "/reports"
@inject ApiClient Api
@inject AuthState Auth

<PageTitle>Отчёты</PageTitle>

@if (!Auth.IsAdmin)
{
    <div class="alert alert-warning">Доступ только для администратора. <a href="login">Войти</a></div>
}
else
{
    <h1>Формирование отчётов</h1>

    @if (_overview != null)
    {
        <div class="row mb-4">
            <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Студентов</div><h3>@_overview.TotalStudents</h3></div></div></div>
            <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Групп</div><h3>@_overview.TotalGroups</h3></div></div></div>
            <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Курсов</div><h3>@_overview.TotalCourses</h3></div></div></div>
            <div class="col-md-3">
                <div class="card"><div class="card-body">
                    <div class="text-muted">По статусам</div>
                    @foreach (var kv in _overview.ByStatus)
                    {
                        <div>@kv.Key: <b>@kv.Value</b></div>
                    }
                </div></div>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>Отчёт по группе (диаграмма активности)</h5>
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Выбрать группу</label>
                    <select class="form-select" @bind="_selectedGroupId">
                        @foreach (var g in _groups)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="BuildGroupReport">Сформировать</button>
                </div>
            </div>

            @if (_groupReport != null)
            {
                <hr />
                <h6>Просмотреть отчёт: @_groupReport.GroupName</h6>
                <p>Курс: @_groupReport.CourseName · Куратор: @_groupReport.Curator</p>

                @if (_groupReport.IsEmpty)
                {
                    <div class="alert alert-secondary">Пустой отчёт — в группе нет студентов.</div>
                }
                else
                {
                    <p>Всего студентов: <b>@_groupReport.TotalStudents</b></p>
                    <ul>
                        @foreach (var kv in _groupReport.ByStatus)
                        {
                            <li>@kv.Key — @kv.Value</li>
                        }
                    </ul>
                    <table class="table table-sm">
                        <thead><tr><th>ФИО</th><th>Статус</th><th>Email</th></tr></thead>
                        <tbody>
                        @foreach (var s in _groupReport.Students)
                        {
                            <tr><td>@s.FullName</td><td>@s.Status</td><td>@s.Email</td></tr>
                        }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Общий контингент</h5>
            <button class="btn btn-outline-primary mb-2" @onclick="LoadContingent">Показать</button>
            @if (_contingent.Count > 0)
            {
                <table class="table table-sm table-striped">
                    <thead><tr><th>ФИО</th><th>Статус</th><th>Группа</th><th>Курс</th></tr></thead>
                    <tbody>
                    @foreach (var item in _contingent)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Status</td>
                            <td>@item.GroupName</td>
                            <td>@item.CourseName</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private OverviewStatisticsDto? _overview;
    private List<GroupDto> _groups = new();
    private int _selectedGroupId;
    private GroupReportDto? _groupReport;
    private List<ContingentItemDto> _contingent = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) return;
        _overview = await Api.GetOverviewAsync();
        _groups = await Api.GetGroupsAsync() ?? new();
        _selectedGroupId = _groups.FirstOrDefault()?.Id ?? 0;
    }

    private async Task BuildGroupReport()
    {
        _groupReport = await Api.GetGroupReportAsync(_selectedGroupId);
    }

    private async Task LoadContingent()
    {
        _contingent = await Api.GetContingentAsync() ?? new();
    }
}
