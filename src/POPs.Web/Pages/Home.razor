@page "/"
@inject AuthState Auth

<PageTitle>Учёт контингента</PageTitle>

<h1>Учёт контингента студентов</h1>

<p class="lead">
    Модуль управления студентами, группами, курсами и отчётами.
</p>

@if (!Auth.IsAuthenticated)
{
    <div class="alert alert-info">
        Войдите в систему, чтобы продолжить.
        <div class="mt-2">
            <a class="btn btn-primary" href="login">Вход</a>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h5>Демо-учётные записи</h5>
            <ul class="mb-0">
                <li><b>Администратор:</b> login <code>admin</code>, пароль <code>admin</code></li>
                <li><b>Студент:</b> login <code>student</code>, пароль <code>student</code></li>
            </ul>
        </div>
    </div>
}
else if (Auth.IsAdmin)
{
    <div class="alert alert-success">
        Вы вошли как администратор. Доступны разделы: студенты, группы, курсы, отчёты.
    </div>
}
else
{
    <div class="alert alert-success">
        Вы вошли как студент. Можно заполнить персональные данные в разделе «Мои данные».
    </div>
}
